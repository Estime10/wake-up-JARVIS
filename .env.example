# Copier vers `.env.local` (gitignoré). Ne jamais committer de secrets.

NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# Legacy (fallback si pas de publishable) :
# NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...

# Ref projet (CLI / docs) — pas un secret
PROJECT_ID=YOUR_PROJECT_REF

# Serveur uniquement — JAMAIS NEXT_PUBLIC_
# SUPABASE_SERVICE_ROLE_KEY=...

# Auth email (dashboard Supabase) :
# Authentication → Providers → Email = ON
# Pour le dev local sans SMTP : Confirm email = OFF
# Site URL : http://localhost:3000

