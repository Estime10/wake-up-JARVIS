# Copier vers `.env.local` (gitignoré). Ne jamais committer de secrets.

NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# Legacy (fallback si pas de publishable) :
# NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...

# Ref projet (CLI / docs) — pas un secret
PROJECT_ID=YOUR_PROJECT_REF

# Serveur uniquement — JAMAIS NEXT_PUBLIC_
# Requis pour OAuth Gmail → Vault (callbacks).
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# Auth email (dashboard Supabase) :
# Authentication → Providers → Email = ON
# Pour le dev local sans SMTP : Confirm email = OFF
# Site URL : http://localhost:3000

# Google OAuth — Gmail readonly (ADR 0010). JAMAIS NEXT_PUBLIC_ sur le secret.
# Client type : Web application
# Redirect URI doit matcher exactement :
GOOGLE_CLIENT_ID=....apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-...
GOOGLE_REDIRECT_URI=http://localhost:3000/api/google/oauth/callback

