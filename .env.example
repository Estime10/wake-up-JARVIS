# Copier vers `.env.local` (gitignoré). Ne jamais committer de secrets.

NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# Legacy (fallback si pas de publishable) :
# NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...

# Ref projet (CLI / docs) — pas un secret
PROJECT_ID=YOUR_PROJECT_REF

# Serveur uniquement — JAMAIS NEXT_PUBLIC_
# Requis pour OAuth Gmail → Vault (callbacks).
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# Auth email (dashboard Supabase) :
# Authentication → Providers → Email = ON
# Pour le dev local sans SMTP : Confirm email = OFF
# Site URL : http://localhost:3000

# Google OAuth — Gmail readonly (ADR 0010). JAMAIS NEXT_PUBLIC_ sur le secret.
# Client type : Web application
# Redirect URI doit matcher exactement :
GOOGLE_CLIENT_ID=....apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-...
GOOGLE_REDIRECT_URI=http://localhost:3000/api/google/oauth/callback

# CLI purge mails hors fenêtre (pnpm mail:purge) — mêmes secrets serveur.

# GitHub — fine-grained PAT stocké via Vault (ADR 0011). Pas de secret d’app
# en env : le PAT est saisi dans l’UI puis écrit côté serveur uniquement.
# Repository access = All repositories (pas « Public repositories » sinon
# seuls les publics apparaissent). Permissions Read : Contents, Metadata, PRs.

# Assistant = intents locaux (rapide). LLM optionnel plus tard (Ollama / Tauri).
# GOOGLE_GENERATIVE_AI_API_KEY=  # non utilisé pour l’instant

# Voix Piper (ADR 0012) — serveur local UNIQUEMENT en loopback.
# macOS (PEP 668) : ne pas pip install système → utiliser le script :
#   ./scripts/run-piper.sh
# (crée .venv-piper + models/piper, puis écoute 127.0.0.1:5911)
# Éviter le port 5000 (AirPlay Receiver macOS).
# PIPER_HTTP_URL=http://127.0.0.1:5911
# PIPER_PROXY_ENABLED=1   # forcer en prod (défaut : on en dev, off en production)
# NEXT_PUBLIC_PIPER_TTS=0 # forcer speechSynthesis seul (debug)

