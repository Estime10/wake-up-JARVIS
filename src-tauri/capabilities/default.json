{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Fenêtre principale E.L.S.A. — panes Studio/browser via invoke (pas d’IPC sur les WV enfants).",
  "windows": ["main"],
  "remote": {
    "urls": [
      "http://127.0.0.1:3000/*",
      "http://localhost:3000/*",
      "https://wake-up-jarvis.vercel.app/*"
    ]
  },
  "permissions": [
    "core:default",
    "allow-studio-ensure",
    "allow-terminal-pty-start",
    "allow-terminal-pty-stop",
    "allow-terminal-pty-write",
    "allow-terminal-pty-resize",
    "core:event:default",
    "allow-voice-speak",
    "allow-voice-stop",
    "allow-webview-pane-set-studio",
    "allow-webview-pane-set-browser",
    "allow-webview-pane-clear-studio",
    "allow-webview-pane-clear-browser",
    "allow-webview-pane-debug"
  ]
}
