{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "DX locale — localhost :3000 avec IPC complet (PTY, Studio, voix, musique).",
  "windows": ["main"],
  "remote": {
    "urls": ["http://127.0.0.1:3000/*", "http://localhost:3000/*"]
  },
  "permissions": [
    "core:default",
    "allow-studio-ensure",
    "allow-terminal-pty-start",
    "allow-terminal-pty-stop",
    "allow-terminal-pty-write",
    "allow-terminal-pty-resize",
    "core:event:default",
    "allow-voice-speak",
    "allow-voice-stop",
    "allow-music-now-playing",
    "allow-music-transport",
    "allow-open-external-url",
    "allow-webview-pane-set-studio",
    "allow-webview-pane-clear-studio",
    "allow-webview-pane-debug"
  ]
}
