{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "ELSA",
  "version": "0.1.0",
  "identifier": "be.devinchat.elsa",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://127.0.0.1:3000",
    "frontendDist": "https://wake-up-jarvis.vercel.app"
  },
  "app": {
    "windows": [
      {
        "title": "E.L.S.A.",
        "width": 1280,
        "height": 800,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.png"
    ],
    "macOS": {
      "minimumSystemVersion": "12.0"
    }
  }
}
